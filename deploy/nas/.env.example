# Copy to deploy/nas/.env, set three different strong values; never commit .env.
CW_DB_OWNER_PASSWORD=CHANGE_ME_OWNER
CW_IMPORT_PASSWORD=CHANGE_ME_IMPORT
CW_READ_PASSWORD=CHANGE_ME_READ
CW_NDW_LOCATIONS_INTERVAL_MINUTES=5
CW_NDW_TARIFFS_INTERVAL_MINUTES=60
CW_NDW_STALE_AFTER_MINUTES=15
CW_NDW_MIN_LOCATIONS=50000
# Enable only after backup + migrations + explicit rollout verification.
CW_ENABLE_COMPACT_STATISTICS=0
# Absolute existing NAS folder for database backups, outside Docker volumes.
CW_NAS_BACKUP_DIR=/volume2/docker/chargewatch/backups
# Full merged commit SHA: sha-<40 hex characters>, same for all three images.
CW_IMAGE_TAG=sha-REPLACE_WITH_MAIN_COMMIT_SHA
